{
  "name": "scribo-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "build": "pnpm --dir packages/scribo build",
    "build:site": "pnpm --dir packages/scribo build:site",
    "dev": "pnpm --dir packages/scribo dev",
